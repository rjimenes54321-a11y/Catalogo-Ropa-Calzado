<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>@ViewBag.Title · Catálogo de ropa y calzado</title>
    <script src="@Url.Content("~/Scripts/tienda.js")"></script>
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" integrity="sha384-QWTKZyjpPEjISv5WaRU9OFeRpok6YctnYmDr5pNlyT2bRjXh0JMhjY6hW+ALEwIH" crossorigin="anonymous" />
    <link rel="stylesheet" href="@Url.Content("~/Content/catalogo.css")" />
</head>
<body>
    <header class="cabecera">
        <nav class="contenedor navegacion" aria-label="Principal">
            <a class="marca" href="@Url.Action("Inicial", "Tienda")">Ropa y calzado</a>
            <div class="acciones">
                <a href="@Url.Action("Inicial", "Tienda")">Inicio</a>
                <a href="@Url.Action("Catalogo", "Tienda")">Catálogo</a>
                @if (User.IsInRole(RolesTienda.Comprador))
                {
                    <a href="@Url.Action("Carrito", "Tienda")">Carrito</a>
                    <a href="@Url.Action("Pedidos", "Tienda")">Mis pedidos</a>
                    <a href="@Url.Action("Perfil", "Cuenta")">Mi cuenta</a>
                    @Html.Partial("_Salir")
                }
                else if (User.Identity.IsAuthenticated)
                {
                    <a href="@Url.Action("Index", "Panel")">Panel</a>
                }
                else
                {
                    <a href="@Url.Action("Ingresar", "Cuenta")">Iniciar sesión</a>
                }
                <button type="button" class="salir" data-tema>Tema oscuro</button>
            </div>
        </nav>
    </header>
    @{ bool personal = User.IsInRole(RolesTienda.Vendedor) || User.IsInRole(RolesTienda.Administrador); }
    <div class="contenedor principal @(personal ? "marco-panel" : "")">
        @if (personal) { @Html.Partial("_NavegacionPanel") }
        <main>
            @if (TempData["Mensaje"] is string) { <p class="aviso" role="status">@TempData["Mensaje"]</p> }
            @if (TempData["Aviso"] is string) { <p class="aviso alerta" role="alert">@TempData["Aviso"]</p> }
            @RenderBody()
        </main>
    </div>
</body>
</html>
