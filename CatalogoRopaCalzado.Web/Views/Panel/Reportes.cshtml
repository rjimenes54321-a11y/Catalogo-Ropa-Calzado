@model ReportesVista
@{ ViewBag.Title = "Reportes"; }
<h1>Reportes</h1>
<dl class="row g-3 mt-2">
<div class="col-6"><div class="panel indicador"><dt>Ventas de hoy</dt><dd>$@Model.VentasDia.ToString("N2")</dd></div></div>
<div class="col-6"><div class="panel indicador"><dt>Ventas del mes</dt><dd>$@Model.VentasMes.ToString("N2")</dd></div></div>
</dl>
<div class="row g-3">
<section class="col-xl-6"><h2 class="h4">Productos más vendidos</h2>@Html.Partial("_Reporte", Model.MasVendidos)</section>
<section class="col-xl-6"><h2 class="h4">Existencias bajas</h2>@Html.Partial("_Reporte", Model.ExistenciasBajas)</section>
</div>
