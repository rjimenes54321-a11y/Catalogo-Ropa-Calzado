@model CatalogoRopaCalzado.ViewModels.ProductoFormulario
@{ ViewBag.Title = "Editar producto"; }
<section class="panel editor">
    <h1>@ViewBag.Title</h1>
    @using (Html.BeginForm("Editar", "Productos", new { id = Model.ProductoId }, FormMethod.Post))
    {
        @Html.AntiForgeryToken()
        @Html.HiddenFor(m => m.StockOriginal)
        @Html.Partial("_Formulario", Model)
        <div class="acciones">
            <button class="boton" type="submit">Guardar cambios</button>
            <a class="boton secundario" href="@Url.Action("Index")">Cancelar</a>
        </div>
    }
</section>
