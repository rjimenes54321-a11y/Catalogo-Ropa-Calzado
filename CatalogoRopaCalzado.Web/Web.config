<?xml version="1.0"?>
<configuration>
  <configSections>
    <section name="entityFramework" type="System.Data.Entity.Internal.ConfigFile.EntityFrameworkSection, EntityFramework" requirePermission="false"/>
  </configSections>
  <connectionStrings>
    <add name="Catalogo" connectionString="Data Source=.\SQLEXPRESS;Initial Catalog=CatalogoRopaCalzado;Integrated Security=True;" providerName="System.Data.SqlClient"/>
  </connectionStrings>
  <system.web>
    <authentication mode="Forms">
      <forms loginUrl="~/Cuenta/Ingresar" cookieless="UseCookies" timeout="30" cookieSameSite="Lax"/>
    </authentication>
    <httpCookies httpOnlyCookies="true" sameSite="Lax"/>
    <compilation targetFramework="4.8" debug="true"/>
    <httpRuntime targetFramework="4.8"/>
    <globalization culture="es-SV" uiCulture="es-SV" fileEncoding="utf-8" requestEncoding="utf-8" responseEncoding="utf-8"/>
    <customErrors mode="On"/>
  </system.web>
  <entityFramework>
    <providers>
      <provider invariantName="System.Data.SqlClient" type="System.Data.Entity.SqlServer.SqlProviderServices, EntityFramework.SqlServer"/>
    </providers>
  </entityFramework>
</configuration>